// NoVaFSM Prisma Schema - Multi-tenant ERP-grade FSM
// PostgreSQL 15 + PostGIS

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ============================================================
// CORE: Organization (Tenant)
// ============================================================

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  currency  String   @default("CAD") // CAD or USD only
  status    String   @default("ACTIVE") // ACTIVE, SUSPENDED, ARCHIVED
  settings  Json     @default("{}") // Org-wide settings
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // Soft delete timestamp

  // Relations
  users          User[]
  customers      Customer[]
  priceLists     PriceList[]
  inventoryItems InventoryItem[]
  jobs           Job[]
  invoices       Invoice[]
  quotes         Quote[]
  auditLogs      AuditLog[]
  outboxEvents   OutboxEvent[]
  sequences      Sequence[]
  taxRates       TaxRate[]
  assets         Asset[]
  documents      Document[]
  formTemplates  FormTemplate[]
  formResponses  FormResponse[]

  @@map("organizations")
}

// ============================================================
// USERS & AUTH
// ============================================================

model User {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  email        String
  password     String // bcrypt hashed
  firstName    String?
  lastName     String?
  phone        String?
  role         String // SUPER_ADMIN, ADMIN, DISPATCHER, TECHNICIAN, CUSTOMER
  status       String    @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  mfaEnabled   Boolean   @default(false)
  mfaSecret    String? // OTP secret
  lastLoginAt  DateTime?
  lastLoginIp  String?
  refreshToken String? // hashed
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // Soft delete timestamp

  // Relations
  organization       Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedJobs       Job[]        @relation("AssignedTechnician")
  timeEntries        TimeEntry[]
  createdQuotes      Quote[]      @relation("QuoteCreator")
  approvedQuotes     Quote[]      @relation("QuoteApprover")
  createdAuditLogs   AuditLog[]
  technicianProfile  Technician?
  expenseEntries     ExpenseEntry[]

  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("users")
}

// ============================================================
// TECHNICIAN PROFILES
// ============================================================

model Technician {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  userId            String   @unique @db.Uuid
  skills            Json     @default("[]") // Array of skill tags
  certifications    Json     @default("[]") // Certifications
  availability      Json     @default("{}") // Weekly availability pattern
  currentLocation   Json? // {lat, lng, timestamp}
  status            String   @default("AVAILABLE") // AVAILABLE, ON_JOB, OFF_DUTY
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime? // Soft delete timestamp

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("technicians")
}

// ============================================================
// CRM: Customers & Sites
// ============================================================

model Customer {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  name            String
  email           String?
  phone           String?
  address         String?
  city            String?
  provinceState   String? // Province (CA) or State (US)
  postalZip       String?
  country         String    @default("CA") // CA or US
  latitude        Float?
  longitude       Float?
  status          String    @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  tags            Json      @default("[]")
  billingAddress  Json? // Full billing address if different
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime? // Soft delete timestamp

  // Relations
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sites        Site[]
  jobs         Job[]
  quotes       Quote[]
  invoices     Invoice[]
  assets       Asset[]
  documents    Document[]

  @@index([tenantId, status])
  @@index([tenantId, email])
  @@index([tenantId, createdAt])
  @@map("customers")
}

model Site {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  customerId    String   @db.Uuid
  name          String?
  address       String
  city          String?
  provinceState String?
  postalZip     String?
  country       String   @default("CA")
  latitude      Float?
  longitude     Float?
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime? // Soft delete timestamp

  // Relations
  customer  Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobs      Job[]
  quotes    Quote[]
  assets    Asset[]
  documents Document[]

  @@index([tenantId, customerId])
  @@map("sites")
}

// ============================================================
// PRICING
// ============================================================

model PriceList {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  description String?
  currency    String   @default("CAD")
  isDefault   Boolean  @default(false)
  status      String   @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? // Soft delete timestamp

  // Relations
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items        PriceItem[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("price_lists")
}

model PriceItem {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @db.Uuid
  priceListId String  @db.Uuid
  sku         String
  name        String
  description String?
  unit        String  @default("EA") // EA, HR, KM, etc.
  defaultRate Decimal @db.Decimal(12, 2)
  taxCode     String? // Tax category code
  isActive    Boolean @default(true)
  category    String? // Parts, Labor, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? // Soft delete timestamp

  // Relations
  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@unique([tenantId, priceListId, sku])
  @@index([tenantId, priceListId])
  @@index([tenantId, sku])
  @@map("price_items")
}

// ============================================================
// TAX RATES
// ============================================================

model TaxRate {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  code          String // GST, PST, HST, QST, VAT, Sales Tax, etc.
  name          String
  rate          Decimal  @db.Decimal(5, 4) // e.g., 0.0500 for 5%
  provinceState String? // Applies to specific province/state
  country       String   @default("CA")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime? // Soft delete timestamp

  // Relations
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code, provinceState])
  @@index([tenantId, isActive])
  @@map("tax_rates")
}

// ============================================================
// QUOTATIONS/ESTIMATES
// ============================================================

model Quote {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  number       String // Q-YYYY-######
  status       String    @default("DRAFT") // DRAFT, SENT, APPROVED, REJECTED, EXPIRED
  currency     String    @default("CAD")
  customerId   String    @db.Uuid
  siteId       String?   @db.Uuid
  title        String?
  description  String?   @db.Text
  subtotal     Decimal   @db.Decimal(12, 2)
  taxTotal     Decimal   @db.Decimal(12, 2)
  total        Decimal   @db.Decimal(12, 2)
  validUntil   DateTime?
  version      Int       @default(1) // Optimistic locking
  notes        String?   @db.Text
  termsConditions String? @db.Text
  createdById  String    @db.Uuid
  approvedAt   DateTime?
  approvedById String?   @db.Uuid
  rejectedAt   DateTime?
  rejectionReason String?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // Soft delete timestamp

  // Relations
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  site         Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("QuoteCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy   User?        @relation("QuoteApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  lines        QuoteLine[]
  jobs         Job[] // Jobs converted from this quote
  invoices     Invoice[] // Invoices generated from this quote

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, createdAt])
  @@map("quotes")
}

model QuoteLine {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @db.Uuid
  quoteId     String  @db.Uuid
  itemId      String? @db.Uuid // Reference to PriceItem if applicable
  sku         String?
  description String
  quantity    Decimal @db.Decimal(12, 3)
  unit        String  @default("EA")
  unitPrice   Decimal @db.Decimal(12, 2)
  discounts   Decimal @default(0) @db.Decimal(12, 2) // Total discounts
  taxes       Json    @default("[]") // [{code, rate, amount}]
  amount      Decimal @db.Decimal(12, 2) // Line total after discounts, before tax
  sort        Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? // Soft delete timestamp

  // Relations
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([tenantId, quoteId])
  @@map("quote_lines")
}

// ============================================================
// JOBS / WORK ORDERS
// ============================================================

model Job {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @db.Uuid
  number               String // J-YYYY-######
  status               String    @default("DRAFT") // DRAFT, SCHEDULED, IN_PROGRESS, ON_HOLD, COMPLETED, CANCELLED
  priority             String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  customerId           String    @db.Uuid
  siteId               String?   @db.Uuid
  quoteId              String?   @db.Uuid // If converted from quote
  title                String
  description          String?   @db.Text
  scheduledStart       DateTime?
  scheduledEnd         DateTime?
  actualStart          DateTime?
  actualEnd            DateTime?
  assignedTechnicianId String?   @db.Uuid
  slaMinutes           Int? // SLA in minutes
  slaDueAt             DateTime?
  version              Int       @default(1)
  checkInLocation      Json? // {lat, lng, timestamp}
  checkOutLocation     Json?
  notes                String?   @db.Text
  internalNotes        String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  completedAt          DateTime?
  deletedAt            DateTime? // Soft delete timestamp

  // Relations
  organization       Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer           Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  site               Site?            @relation(fields: [siteId], references: [id], onDelete: SetNull)
  quote              Quote?           @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  assignedTechnician User?            @relation("AssignedTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  timeEntries        TimeEntry[]
  expenseEntries     ExpenseEntry[]
  inventoryUsages    InventoryUsage[]
  invoice            Invoice?
  assets             Asset[]
  documents          Document[]
  formAssignments    FormAssignment[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, assignedTechnicianId])
  @@index([tenantId, scheduledStart])
  @@index([tenantId, customerId])
  @@index([tenantId, createdAt])
  @@map("jobs")
}

// ============================================================
// INVOICING
// ============================================================

model Invoice {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  number      String // INV-YYYY-######
  status      String    @default("DRAFT") // DRAFT, SENT, PAID, OVERDUE, CANCELLED
  currency    String    @default("CAD")
  customerId  String    @db.Uuid
  jobId       String?   @unique @db.Uuid
  quoteId     String?   @db.Uuid
  subtotal    Decimal   @db.Decimal(12, 2)
  taxTotal    Decimal   @db.Decimal(12, 2)
  total       Decimal   @db.Decimal(12, 2)
  lines       Json      @default("[]") // Invoice lines as JSON
  notes       String?   @db.Text
  termsConditions String? @db.Text
  issuedAt    DateTime?
  dueAt       DateTime?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // Soft delete timestamp

  // Relations
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  job          Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  quote        Quote?       @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, createdAt])
  @@map("invoices")
}

// ============================================================
// INVENTORY
// ============================================================

model InventoryItem {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  sku         String
  name        String
  description String?
  category    String?
  unit        String   @default("EA")
  qtyOnHand   Decimal  @default(0) @db.Decimal(12, 3)
  qtyReserved Decimal  @default(0) @db.Decimal(12, 3)
  reorderPoint Decimal? @db.Decimal(12, 3)
  location    String?
  cost        Decimal? @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? // Soft delete timestamp

  // Relations
  organization Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usages       InventoryUsage[]

  @@unique([tenantId, sku])
  @@index([tenantId, isActive])
  @@index([tenantId, category])
  @@map("inventory_items")
}

model InventoryUsage {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  jobId     String   @db.Uuid
  itemId    String   @db.Uuid
  quantity  Decimal  @db.Decimal(12, 3)
  notes     String?
  createdAt DateTime @default(now())

  // Relations
  job  Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([tenantId, jobId])
  @@index([tenantId, itemId])
  @@map("inventory_usages")
}

// ============================================================
// TIME & EXPENSE
// ============================================================

model TimeEntry {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  jobId     String?   @db.Uuid
  type      String    @default("WORK") // WORK, TRAVEL, BREAK
  startTime DateTime
  endTime   DateTime?
  duration  Int? // Calculated duration in minutes
  notes     String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete timestamp

  // Relations
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job?  @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([tenantId, userId])
  @@index([tenantId, jobId])
  @@index([tenantId, startTime])
  @@map("time_entries")
}

model ExpenseEntry {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  userId      String   @db.Uuid
  jobId       String?  @db.Uuid
  type        String // MILEAGE, MATERIALS, MEALS, OTHER
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("CAD")
  description String
  receiptUrl  String?
  expenseDate DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? // Soft delete timestamp

  // Relations
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job?  @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([tenantId, userId])
  @@index([tenantId, jobId])
  @@index([tenantId, expenseDate])
  @@map("expense_entries")
}

// ============================================================
// SEQUENCES (Number Generation)
// ============================================================

model Sequence {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  type      String // QUOTE, JOB, INVOICE, etc.
  value     Int      @default(0)
  year      Int // To support YYYY format
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type, year])
  @@map("sequences")
}

// ============================================================
// AUDIT LOGGING
// ============================================================

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String?  @db.Uuid
  action    String // CREATE, UPDATE, DELETE, etc.
  entity    String // Table/model name
  entityId  String?  @db.Uuid
  payload   Json? // Changed data
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, entity, entityId])
  @@index([tenantId, userId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ============================================================
// OUTBOX PATTERN (Event Sourcing)
// ============================================================

model OutboxEvent {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  eventName   String // quote.approved, job.assigned, etc.
  payload     Json
  status      String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  attempts    Int      @default(0)
  lastAttempt DateTime?
  error       String?  @db.Text
  createdAt   DateTime @default(now())
  processedAt DateTime?

  // Relations
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("outbox_events")
}

// ============================================================
// IDEMPOTENCY (Mobile Sync)
// ============================================================

model IdempotencyKey {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  key        String
  endpoint   String
  response   Json
  statusCode Int
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@unique([tenantId, key])
  @@index([tenantId, expiresAt])
  @@map("idempotency_keys")
}

// ============================================================
// ASSET & EQUIPMENT TRACKING
// ============================================================

model Asset {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  category          String // HEAVY_EQUIPMENT, VEHICLE, TOOL, MODULE, TRAILER, OTHER
  status            String    @default("AVAILABLE") // AVAILABLE, IN_USE, MAINTENANCE, RETIRED
  name              String
  serialNumber      String?
  model             String?
  vendor            String?
  purchaseDate      DateTime?
  purchaseCost      Decimal?  @db.Decimal(12, 2)
  warrantyExpires   DateTime?
  lastMaintenance   DateTime?
  nextMaintenance   DateTime?
  assignedToType    String? // JOB, SITE, TECHNICIAN, CUSTOMER, null
  assignedToId      String?   @db.Uuid
  customerId        String?   @db.Uuid
  siteId            String?   @db.Uuid
  jobId             String?   @db.Uuid
  technicianId      String?   @db.Uuid
  geoLocation       Json? // {lat, lng, timestamp}
  hourlyRate        Decimal?  @db.Decimal(12, 2) // For billing if rented
  dailyRate         Decimal?  @db.Decimal(12, 2)
  specifications    Json      @default("{}") // Technical specs
  maintenanceLogs   Json      @default("[]") // Array of maintenance records
  usageHistory      Json      @default("[]") // Assignment history
  qrCode            String?
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime? // Soft delete timestamp

  // Relations
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  site         Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  job          Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  documents    Document[]

  @@index([tenantId, status])
  @@index([tenantId, category])
  @@index([tenantId, assignedToType, assignedToId])
  @@index([tenantId, customerId])
  @@index([tenantId, serialNumber])
  @@map("assets")
}

// ============================================================
// DOCUMENT MANAGEMENT SYSTEM
// ============================================================

model Document {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  fileName        String
  originalName    String
  mimeType        String
  size            Int // bytes
  s3Key           String // S3 object key
  s3Bucket        String
  version         Int      @default(1)
  parentId        String?  @db.Uuid // For versioning
  virtualPath     String? // Folder-like path
  tags            Json     @default("[]") // Array of string tags
  entityType      String? // CUSTOMER, SITE, JOB, QUOTE, INVOICE, ASSET, etc.
  entityId        String?  @db.Uuid
  customerId      String?  @db.Uuid
  siteId          String?  @db.Uuid
  jobId           String?  @db.Uuid
  quoteId         String?  @db.Uuid
  invoiceId       String?  @db.Uuid
  assetId         String?  @db.Uuid
  uploadedById    String?  @db.Uuid
  description     String?  @db.Text
  isPublic        Boolean  @default(false) // Public to customer
  metadata        Json     @default("{}") // Additional metadata
  checksum        String? // For integrity verification
  expiresAt       DateTime? // For temporary documents
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime? // Soft delete timestamp

  // Relations
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  site         Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  job          Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  asset        Asset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)
  parent       Document?    @relation("DocumentVersions", fields: [parentId], references: [id], onDelete: Cascade)
  versions     Document[]   @relation("DocumentVersions")

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, customerId])
  @@index([tenantId, s3Key])
  @@index([tenantId, createdAt])
  @@index([tenantId, expiresAt])
  @@map("documents")
}

// ============================================================
// DYNAMIC FORM BUILDER
// ============================================================

model FormTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  description String?  @db.Text
  category    String // INSPECTION, SAFETY, AUDIT, CHECKLIST, SURVEY, etc.
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  isPublished Boolean  @default(false)
  fields      Json     @default("[]") // Array of field definitions
  logic       Json     @default("{}") // Conditional logic rules
  settings    Json     @default("{}") // Form-level settings
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? // Soft delete timestamp

  // Relations
  organization  Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments   FormAssignment[]
  responses     FormResponse[]

  @@index([tenantId, isActive])
  @@index([tenantId, category])
  @@map("form_templates")
}

model FormAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  templateId   String    @db.Uuid
  assignedType String // JOB, SITE, ASSET, INSPECTION
  assignedToId String?   @db.Uuid
  jobId        String?   @db.Uuid
  siteId       String?   @db.Uuid
  assetId      String?   @db.Uuid
  assignedById String?   @db.Uuid
  dueDate      DateTime?
  status       String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, OVERDUE
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // Soft delete timestamp

  // Relations
  template FormTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  job      Job?          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  response FormResponse?

  @@index([tenantId, templateId])
  @@index([tenantId, assignedType, assignedToId])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@map("form_assignments")
}

model FormResponse {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  templateId     String   @db.Uuid
  assignmentId   String?  @unique @db.Uuid
  responses      Json     @default("{}") // Field ID -> value mapping
  submittedById  String?  @db.Uuid
  submittedAt    DateTime?
  latitude       Float?
  longitude      Float?
  deviceInfo     Json? // Device metadata
  pdfUrl         String? // Generated PDF URL
  status         String   @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED
  score          Int? // If scoring enabled
  reviewNotes    String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime? // Soft delete timestamp

  // Relations
  organization Organization    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template     FormTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  assignment   FormAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, templateId])
  @@index([tenantId, status])
  @@index([tenantId, submittedAt])
  @@map("form_responses")
}

// ============================================================
// REFRESH TOKEN BLACKLIST
// ============================================================

model TokenBlacklist {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique // Hashed refresh token
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("token_blacklist")
}
