# Backend API Configuration

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://novafsm:novafsm_dev_pass@localhost:5432/novafsm?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (RS256)
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=novafsm
JWT_AUDIENCE=novafsm-api

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3/MinIO
S3_BUCKET=novafsm-uploads
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_USE_SSL=false

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=change-this-to-random-64-char-string

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# OpenTelemetry
OTEL_ENABLED=true
OTEL_SERVICE_NAME=novafsm-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER_RATIO=0.1
