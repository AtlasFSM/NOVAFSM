# NoVaFSM Environment Configuration
# Copy to .env and fill in actual values

# ===========================
# ENVIRONMENT
# ===========================
NODE_ENV=development

# ===========================
# BACKEND API
# ===========================
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0

# ===========================
# DATABASE
# ===========================
DATABASE_URL=postgresql://novafsm:novafsm_dev_pass@localhost:5432/novafsm?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ===========================
# REDIS
# ===========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===========================
# JWT AUTHENTICATION (RS256)
# ===========================
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAKCAQEA... (your private key)\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8A... (your public key)\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=novafsm
JWT_AUDIENCE=novafsm-api

# ===========================
# AWS (Production)
# ===========================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3
S3_BUCKET=novafsm-uploads
S3_ENDPOINT=  # Leave empty for AWS S3
S3_FORCE_PATH_STYLE=false

# Secrets Manager
AWS_SECRETS_MANAGER_ENABLED=false
AWS_SECRETS_MANAGER_SECRET_NAME=

# ===========================
# MINIO (Local Development)
# ===========================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=novafsm-uploads
MINIO_USE_SSL=false

# ===========================
# CORS
# ===========================
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# ===========================
# OBSERVABILITY
# ===========================
OTEL_ENABLED=true
OTEL_SERVICE_NAME=novafsm-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER_RATIO=0.1

# ===========================
# RATE LIMITING
# ===========================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ===========================
# SECURITY
# ===========================
BCRYPT_ROUNDS=12
SESSION_SECRET=change-this-to-random-64-char-string-in-production

# ===========================
# WEB DASHBOARD
# ===========================
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# ===========================
# MOBILE APP
# ===========================
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WS_URL=ws://localhost:3000
